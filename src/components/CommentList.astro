---
import type { CollectionEntry } from 'astro:content';
import { linkifyArticleRefs } from '../lib/articleLinks';
import { resolveCommentTarget } from '../lib/commentLinks';

interface Props {
	comments: CollectionEntry<'comments'>[];
	heading: string;
	// true の場合、各コメントが元の条文・改憲案ページへのリンクを表示する
	// (タグ別一覧など、複数の条文のコメントを横断して表示するページで使う。Issue #125)。
	showContext?: boolean;
}

const { comments, heading, showContext = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const stanceLabel = { support: '賛成', oppose: '反対', neutral: '中立' } as const;
const claimTypeLabel = { fact: '事実', interpretation: '解釈', concern: '懸念・予測', quote: '引用' } as const;

// 本文中の「第96条」等の条文番号表記を、該当ページへのリンクに変換する (Issue #86)。
const linkedText = await Promise.all(
	comments.map(async (comment) => ({
		excerpt: await linkifyArticleRefs(comment.data.excerpt, comment.data.draft_id, base),
		summary: await linkifyArticleRefs(comment.data.summary, comment.data.draft_id, base),
	})),
);

const contextLinks = showContext
	? await Promise.all(comments.map((comment) => resolveCommentTarget(comment, base)))
	: [];
---

{comments.length > 0 && (
	<section class="mt-8">
		<h2 class="font-mono mb-3 text-sm" style="color: var(--ink-muted);">{heading}({comments.length})</h2>
		<ul class="space-y-4">
			{comments.map((comment, i) => (
				<li class="overflow-hidden rounded-md border" style="border-color: var(--line);">
					<div class="flex items-center gap-2 border-b px-3 py-2 text-sm" style="border-color: var(--line); background: var(--paper-raised);">
						<span class="avatar" aria-hidden="true">{comment.data.speaker.name.slice(0, 1)}</span>
						<a href={`${base}search?q=${encodeURIComponent(comment.data.speaker.name)}`} class="no-underline hover:underline">
							<strong style="color: var(--ink);">{comment.data.speaker.name}</strong>
						</a>
						<span class="tag">{comment.data.speaker.party}</span>
						<span class="font-mono ml-auto text-xs" style="color: var(--ink-muted);">
							{comment.data.date.toISOString().slice(0, 10)}
						</span>
					</div>
					<div class="comment-card m-3" data-stance={comment.data.stance}>
						<p class="mb-2 text-xs" style="color: var(--ink-muted);">
							{comment.data.speaker.role} ・ {stanceLabel[comment.data.stance]} ・ {claimTypeLabel[comment.data.claim_type]}
							{showContext && (
								<>
									{' '}・ <a href={contextLinks[i].href}>{contextLinks[i].label}</a>
								</>
							)}
						</p>
						<blockquote class="font-mincho mb-2 border-l-2 pl-3" style="border-color: var(--line); color: var(--ink);" set:html={linkedText[i].excerpt} />
						<p class="mb-1 flex items-center gap-1.5 text-xs" style="color: var(--ink-muted);">
							要約
							{comment.data.summary_source === 'ai' && <span class="tag">AIによる要約</span>}
						</p>
						<p class="mb-1 text-sm" style="color: var(--ink);" set:html={linkedText[i].summary} />
						<p class="font-mono text-xs" style="color: var(--ink-muted);">
							{comment.data.venue}
							{comment.data.source_url && (
								<>
									{' '}/ <a href={comment.data.source_url}>出典</a>
								</>
							)}
						</p>
						{comment.data.tags.length > 0 && (
							<p class="mt-2 flex flex-wrap gap-1">
								{comment.data.tags.map((tag) => (
									<a href={`${base}tags/${encodeURIComponent(tag)}`} class="tag no-underline hover:underline">
										{tag}
									</a>
								))}
							</p>
						)}
					</div>
				</li>
			))}
		</ul>
	</section>
)}
