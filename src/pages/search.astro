---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="検索 | 日本国憲法レビュー" description="条文・改憲案を全文検索します。">
	<link slot="head" href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />

	<p class="font-mono mb-4 text-sm">
		<a href={base}>&larr; トップへ戻る</a>
	</p>
	<h1 class="font-mincho mb-3 text-xl" style="color: var(--ink);">検索</h1>
	<p class="mb-6 text-sm" style="color: var(--ink-muted);">
		条文・改憲案を全文検索できます(開発中のため
		<code class="font-mono">npm run build</code>
		後の <code class="font-mono">npm run preview</code> でのみ動作します。
		<code class="font-mono">npm run dev</code> では索引が生成されません)。
	</p>
	<div id="search"></div>
	<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
	<script is:inline>
		window.addEventListener('DOMContentLoaded', () => {
			if (typeof PagefindUI !== 'undefined') {
				new PagefindUI({ element: '#search', showSubResults: true });
			}
		});
	</script>
</BaseLayout>
