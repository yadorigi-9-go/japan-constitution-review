---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="検索 | 日本国憲法レビュー" description="条文・改憲案を全文検索します。">
	<link slot="head" href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />

	<p class="font-mono mb-4 text-sm">
		<a href={base}>&larr; トップへ戻る</a>
	</p>
	<h1 class="font-mincho mb-3 text-xl" style="color: var(--ink);">検索</h1>
	{import.meta.env.DEV ? (
		<p class="mb-6 text-sm" style="color: var(--ink-muted);">
			条文・改憲案を全文検索できます(ローカル開発時は索引が未生成のため、
			<code class="font-mono">npm run build</code>
			後の <code class="font-mono">npm run preview</code> で確認してください。
			<code class="font-mono">npm run dev</code> では動作しません)。
		</p>
	) : (
		<p class="mb-6 text-sm" style="color: var(--ink-muted);">条文・改憲案を全文検索できます。</p>
	)}
	<div id="search"></div>
	<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
	<script is:inline>
		window.addEventListener('DOMContentLoaded', () => {
			if (typeof PagefindUI === 'undefined') return;
			new PagefindUI({
				element: '#search',
				showSubResults: true,
				// 日本語など単語分割できない言語は1文字単位のAND検索になり、
				// 「9条」が「90条」等にもマッチしてしまう。スペースを含まない
				// 入力は完全一致(引用符)検索に変換してノイズを減らす。
				processTerm: (term) => {
					const trimmed = term.trim();
					if (!trimmed || /\s/.test(trimmed)) return term;
					if (trimmed.startsWith('"') && trimmed.endsWith('"')) return term;
					return `"${trimmed}"`;
				},
			});

			// ?q=<発言者名> 等で来た場合、Pagefind UI の検索欄に自動入力する
			// (issue #81: CommentList の発言者名からの検索導線)。
			const q = new URLSearchParams(window.location.search).get('q');
			if (!q) return;
			const trySetQuery = () => {
				const input = document.querySelector('#search input[type="text"]');
				if (!input) {
					setTimeout(trySetQuery, 50);
					return;
				}
				input.value = q;
				input.dispatchEvent(new Event('input', { bubbles: true }));
			};
			trySetQuery();
		});
	</script>
</BaseLayout>
