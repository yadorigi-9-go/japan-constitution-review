---
import { getCollection } from 'astro:content';

// 前文を先頭に、条文は条文番号(数値)の昇順で並べる。
const articles = (await getCollection('articles')).sort((a, b) => {
  if (a.data.kind !== b.data.kind) {
    return a.data.kind === 'preamble' ? -1 : 1;
  }
  if (a.data.kind === 'article' && b.data.kind === 'article') {
    return a.data.number - b.data.number;
  }
  return 0;
});

// verified: false のコメントは件数に数えない (docs/design.md 10)
const verifiedComments = (await getCollection('comments')).filter((comment) => comment.data.verified);
const commentCountByArticleId = new Map<string, number>();
for (const comment of verifiedComments) {
  for (const articleId of comment.data.article_ids) {
    commentCountByArticleId.set(articleId, (commentCountByArticleId.get(articleId) ?? 0) + 1);
  }
}
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>日本国憲法レビュー(準備中)</title>
	</head>
	<body>
		<h1>日本国憲法レビュー</h1>
		<p>準備中です。設計は <a href="https://github.com/yadorigi-9-go/japan-constitution-review/blob/main/docs/design.md">docs/design.md</a> を参照してください。</p>
		<p><a href={`${import.meta.env.BASE_URL}drafts`}>改憲案一覧</a></p>
		<p><a href={`${import.meta.env.BASE_URL}search`}>検索</a></p>
		<ul>
			{articles.map((article) => {
				const count = commentCountByArticleId.get(article.id) ?? 0;
				return (
					<li>
						<a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
							{article.data.kind === 'preamble' ? '前文' : `第${article.data.number}条`}
						</a>
						{count > 0 && ` (コメント${count}件)`}
					</li>
				);
			})}
		</ul>
	</body>
</html>
