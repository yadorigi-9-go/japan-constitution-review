---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const drafts = (await getCollection('drafts')).sort(
  (a, b) => a.data.published_at.getTime() - b.data.published_at.getTime(),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="改憲案 | 日本国憲法レビュー" description="改憲案の一覧。現行憲法との差分と論点を条文単位で確認できます。">
	<p class="font-mono mb-4 text-sm">
		<a href={base}>&larr; 条文一覧</a>
	</p>
	<h1 class="font-mincho mb-4 text-xl" style="color: var(--ink);">改憲案</h1>

	<ul class="divide-y border-t border-b" style="border-color: var(--line);">
		{drafts.map((draft) => (
			<li class="flex items-start gap-3 py-3">
				<span class="mt-1.5 inline-block h-3 w-3 shrink-0 rounded-full" style="background: var(--success);" aria-hidden="true" />
				<div>
					<a href={`${base}drafts/${draft.id}`} class="no-underline hover:underline">
						<span class="font-mincho text-lg" style="color: var(--ink);">{draft.data.name}</span>
					</a>
					<p class="font-mono mt-1 text-xs" style="color: var(--ink-muted);">
						<span class="tag">提案</span>
						{' '}{draft.data.proposer}が {draft.data.published_at.toISOString().slice(0, 10)} に公表
						{draft.data.status === 'outline' && <span class="tag ml-1">たたき台(未完成)</span>}
					</p>
				</div>
			</li>
		))}
	</ul>
</BaseLayout>
