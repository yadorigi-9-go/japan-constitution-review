---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CommentList from '../../../../components/CommentList.astro';
import { articleLabel } from '../../../../lib/draftDiff';

export async function getStaticPaths() {
  const drafts = await getCollection('drafts');
  const draftDeletions = await getCollection('draftDeletions');
  const draftById = new Map(drafts.map((draft) => [draft.id, draft]));

  return draftDeletions.map((entry) => {
    const [draftId] = entry.id.split('/');
    return {
      params: { draftId, articleId: entry.data.id },
      props: { draft: draftById.get(draftId)!, entry },
    };
  });
}

interface Props {
  draft: CollectionEntry<'drafts'>;
  entry: CollectionEntry<'draftDeletions'>;
}

const { draft, entry } = Astro.props;
const current = await getEntry('articles', entry.data.id);
const paragraphs = current && (current.data.kind === 'article' || current.data.kind === 'preamble') ? current.data.paragraphs : [];
const base = import.meta.env.BASE_URL;

// この削除される条文番号に、別の現行条文からの改番で同じ番号の条文が新設されることが
// ある(例: 現行97条の削除と、現行95条からの改番による新97条。design.md 5.2)。この
// とき、改番後の条文(art-XXX.yaml)と削除(del-art-XXX.yaml)とで id(番号)が衝突
// する。改番後の条文へのコメントは 5.5節の規約により article_ids に改番前・改番後
// 両方のidを含むため、改番前のidも含むコメントは衝突側(削除)のものではないとみなし、
// ここでは除外する。
const draftArticles = await getCollection('draftArticles');
const collidingRename = draftArticles.find(
  (a) =>
    a.id.startsWith(`${draft.id}/`) &&
    a.data.id === entry.data.id &&
    a.data.renamed_from &&
    a.data.renamed_from !== a.data.id,
);

// verified: false のコメントは公開しない (docs/design.md 10)
const comments = (await getCollection('comments')).filter(
  (comment) =>
    comment.data.verified &&
    comment.data.draft_id === draft.id &&
    comment.data.article_ids.includes(entry.data.id) &&
    !(collidingRename && comment.data.article_ids.includes(collidingRename.data.renamed_from!)),
);
---

<BaseLayout
	title={`${entry.data.title} | ${draft.data.name} | 日本国憲法レビュー`}
	description={`${draft.data.name}により削除される${articleLabel(entry.data.id)}(${entry.data.title})。`}
	ogImage={`${base}og/drafts/${draft.id}/deleted/${entry.data.id}.png`}
>
	<p class="font-mono mb-4 text-sm">
		<a href={`${base}drafts/${draft.id}`}>&larr; {draft.data.name}</a>
	</p>

	<div class="overflow-hidden rounded-md border" style="border-color: var(--line);">
		<div class="border-b px-4 py-3" style="border-color: var(--line); background: var(--paper-raised);">
			<h1 class="font-mincho text-lg" style="color: var(--ink);">{entry.data.title}</h1>
			<p class="font-mono mt-1 flex items-center gap-2 text-sm" style="color: var(--ink-muted);">
				{articleLabel(entry.data.id)}
				<span class="tag">削除</span>
			</p>
		</div>
		<div class="font-mono px-3 py-3 text-sm leading-relaxed">
			{paragraphs.map((p) => (
				<div class="flex gap-3 py-1">
					<span class="shrink-0 text-right" style="width: 1.5rem; color: var(--ink-muted);">{p.no}</span>
					<p style="color: var(--ink);"><del>{p.text}</del></p>
				</div>
			))}
		</div>
	</div>

	<p class="font-mono mt-4 text-xs" style="color: var(--ink-muted);">
		出典: <a href={entry.data.source_url}>{entry.data.source_url}</a> / 最終確認日: {entry.data.retrieved_at.toISOString().slice(0, 10)}
	</p>

	<CommentList comments={comments} heading="この削除についてのコメント" />
</BaseLayout>
