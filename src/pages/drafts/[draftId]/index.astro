---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articleLabel } from '../../../lib/draftDiff';

export async function getStaticPaths() {
  const drafts = await getCollection('drafts');
  return drafts.map((draft) => ({
    params: { draftId: draft.id },
    props: { draft },
  }));
}

interface Props {
  draft: CollectionEntry<'drafts'>;
}

const { draft } = Astro.props;

// id が "<draftId>/art-XXX" になっている (src/content.config.ts の generateId)。
// 前文は number を持たないため、文字列比較だと "art-*" より後ろに来てしまう。
// 常に先頭に来るよう、前文は -1 として扱う。
const changedArticles = (await getCollection('draftArticles'))
  .filter((entry) => entry.id.startsWith(`${draft.id}/`))
  .sort((a, b) => (a.data.number ?? -1) - (b.data.number ?? -1));

// 条文ごと削除される項目 (id が "<draftId>/del-art-XXX" になっている)
const deletedArticles = (await getCollection('draftDeletions'))
  .filter((entry) => entry.id.startsWith(`${draft.id}/`))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title={`${draft.data.name} | 日本国憲法レビュー`}
	description={`${draft.data.name}(${draft.data.proposer}提案)が現行憲法から変更する条文の一覧。`}
>
	<p class="font-mono mb-4 text-sm">
		<a href={`${base}drafts`}>&larr; 改憲案一覧</a>
	</p>
	<h1 class="font-mincho mb-2 text-xl" style="color: var(--ink);">{draft.data.name}</h1>
	<div class="font-mono mb-4 space-y-0.5 text-xs" style="color: var(--ink-muted);">
		<p>提案: {draft.data.proposer} / 公表日: {draft.data.published_at.toISOString().slice(0, 10)}</p>
		<p>出典: <a href={draft.data.source_url}>{draft.data.source_url}</a></p>
		<p>最終確認日: {draft.data.retrieved_at.toISOString().slice(0, 10)}</p>
	</div>

	<p class="font-mono mb-8 text-sm">
		<a href={`${base}drafts/${draft.id}/branch`} class="rounded-md border px-3 py-1.5 no-underline hover:underline" style="border-color: var(--line);">
			ブランチとして全文を見る(成立後の条文を、前文から通しで表示する) →
		</a>
	</p>

	<h2 class="font-mono mb-3 text-sm" style="color: var(--ink-muted);">変更された条文({changedArticles.length + deletedArticles.length})</h2>
	<ul class="divide-y border-t border-b" style="border-color: var(--line);">
		{changedArticles.map((entry) => (
			<li class="flex items-start gap-3 py-3">
				<span class="mt-1.5 inline-block h-3 w-3 shrink-0 rounded-full" style="background: var(--danger);" aria-hidden="true" />
				<div>
					<a href={`${base}drafts/${draft.id}/${entry.data.id}`} class="no-underline hover:underline">
						<span class="font-mincho text-lg" style="color: var(--ink);">{entry.data.title}</span>
					</a>
					<p class="font-mono mt-1 text-xs" style="color: var(--ink-muted);">
						{entry.data.renamed_from && entry.data.renamed_from !== entry.data.id
							? `${articleLabel(entry.data.renamed_from)} → ${articleLabel(entry.data.id)}`
							: articleLabel(entry.data.id)}
					</p>
				</div>
			</li>
		))}
		{deletedArticles.map((entry) => (
			<li class="flex items-start gap-3 py-3">
				<span class="mt-1.5 inline-block h-3 w-3 shrink-0 rounded-full" style="background: var(--ink-muted);" aria-hidden="true" />
				<div>
					<a href={`${base}drafts/${draft.id}/deleted/${entry.data.id}`} class="no-underline hover:underline">
						<span class="font-mincho text-lg" style="color: var(--ink);">{entry.data.title}</span>
					</a>
					<p class="font-mono mt-1 text-xs" style="color: var(--ink-muted);">
						{articleLabel(entry.data.id)}
						<span class="tag">削除</span>
					</p>
				</div>
			</li>
		))}
	</ul>
</BaseLayout>
