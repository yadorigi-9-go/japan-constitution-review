---
import { getCollection, getEntry } from 'astro:content';
import { diffChars } from 'diff';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const drafts = await getCollection('drafts');
  return drafts.map((draft) => ({
    params: { draftId: draft.id },
    props: { draft },
  }));
}

const { draft } = Astro.props;

// id が "<draftId>/art-XXX" になっている (src/content.config.ts の generateId)
const changedArticles = (await getCollection('draftArticles'))
  .filter((entry) => entry.id.startsWith(`${draft.id}/`))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

function articleLabel(id: string): string {
  const m = id.match(/^art-(\d+)(?:-(\d+))?$/);
  if (!m) return id;
  const num = Number(m[1]);
  return m[2] ? `第${num}条の${Number(m[2])}` : `第${num}条`;
}

const rows = await Promise.all(
  changedArticles.map(async (entry) => {
    const current = await getEntry('articles', entry.data.id);
    const isNew = !current || current.data.kind !== 'article';
    const oldParagraphs = !isNew && current ? current.data.paragraphs : [];
    const newParagraphs = entry.data.paragraphs;

    const paragraphNos = [...new Set([...oldParagraphs, ...newParagraphs].map((p) => p.no))].sort(
      (a, b) => a - b,
    );
    const paragraphDiffs = paragraphNos.map((no) => {
      const oldText = oldParagraphs.find((p) => p.no === no)?.text ?? '';
      const newText = newParagraphs.find((p) => p.no === no)?.text ?? '';
      return { no, parts: diffChars(oldText, newText) };
    });

    return { id: entry.data.id, isNew, paragraphDiffs };
  }),
);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${draft.data.name} | 日本国憲法レビュー`}>
	<p class="font-mono mb-4 text-sm">
		<a href={`${base}drafts`}>&larr; 改憲案一覧</a>
	</p>
	<h1 class="font-mincho mb-2 text-xl" style="color: var(--ink);">{draft.data.name}</h1>
	<div class="font-mono mb-8 space-y-0.5 text-xs" style="color: var(--ink-muted);">
		<p>提案: {draft.data.proposer} / 公表日: {draft.data.published_at.toISOString().slice(0, 10)}</p>
		<p>出典: <a href={draft.data.source_url}>{draft.data.source_url}</a></p>
		<p>最終確認日: {draft.data.retrieved_at.toISOString().slice(0, 10)}</p>
	</div>

	<div class="space-y-6">
		{rows.map((row) => (
			<div class="overflow-hidden rounded-md border" style="border-color: var(--line);">
				<div class="font-mono flex items-center gap-2 border-b px-3 py-2 text-sm" style="border-color: var(--line); background: var(--paper-raised);">
					<span class="font-mincho" style="color: var(--ink);">{articleLabel(row.id)}</span>
					{row.isNew && <span class="tag tag-new">新設</span>}
				</div>
				<div class="font-mono px-3 py-3 text-sm leading-relaxed">
					{row.paragraphDiffs.map((pd) => (
						<div class="flex gap-3 py-1">
							<span class="shrink-0 text-right" style="width: 1.5rem; color: var(--ink-muted);">{pd.no}</span>
							<p style="color: var(--ink);">
								{pd.parts.map((part) =>
									part.added ? (
										<ins>{part.value}</ins>
									) : part.removed ? (
										<del>{part.value}</del>
									) : (
										<span>{part.value}</span>
									),
								)}
							</p>
						</div>
					))}
				</div>
			</div>
		))}
	</div>
</BaseLayout>
