---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommentList from '../../../components/CommentList.astro';
import DraftArticleDiffCard from '../../../components/DraftArticleDiffCard.astro';
import { computeDraftArticleDiff } from '../../../lib/draftDiff';
import { getDraftArticleComments } from '../../../lib/draftComments';

export async function getStaticPaths() {
  const drafts = await getCollection('drafts');
  const draftArticles = await getCollection('draftArticles');
  const draftById = new Map(drafts.map((draft) => [draft.id, draft]));

  return draftArticles.map((entry) => {
    const [draftId] = entry.id.split('/');
    return {
      params: { draftId, articleId: entry.data.id },
      props: { draft: draftById.get(draftId)!, entry },
    };
  });
}

interface Props {
  draft: CollectionEntry<'drafts'>;
  entry: CollectionEntry<'draftArticles'>;
}

const { draft, entry } = Astro.props;
const row = await computeDraftArticleDiff(entry);
const base = import.meta.env.BASE_URL;

// この改憲案に対するコメント(draft_id が一致し、この条文を対象とするもの)のみを表示する。
// 現行条文へのコメント(draft_id: null)は /articles/[id] 側に表示されるため、ここには出さない。
// 番号の衝突(改番・新設・削除)の扱いを含む判定は src/lib/draftComments.ts に集約し、
// 改憲案の条文一覧の件数と一致させる(Issue #220)。
const comments = await getDraftArticleComments(entry);
---

<BaseLayout
	title={`${row.title} | ${draft.data.name} | 日本国憲法レビュー`}
	description={`${draft.data.name}による${row.title}の変更内容(現行憲法との差分)。`}
	ogImage={`${base}og/drafts/${draft.id}/${entry.data.id}.png`}
	breadcrumb={[
		{ name: '条文', href: base },
		{ name: '改憲案', href: `${base}drafts` },
		{ name: draft.data.name, href: `${base}drafts/${draft.id}` },
		{ name: row.title },
	]}
	pagefindFilters={{ 種類: '改憲案条文', 改憲案: draft.data.name }}
>
	<p class="font-mono mb-4 text-sm">
		<a href={`${base}drafts/${draft.id}`}>&larr; {draft.data.name}</a>
	</p>

	<DraftArticleDiffCard row={row} />

	<CommentList comments={comments} heading="この変更についてのコメント" />

	<p class="font-mono mt-4 text-xs" style="color: var(--ink-muted);">
		出典: <a href={entry.data.source_url}>{entry.data.source_url}</a> / 最終確認日: {entry.data.retrieved_at.toISOString().slice(0, 10)}
	</p>
</BaseLayout>
