---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentList from '../../components/CommentList.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { kind, paragraphs, source_url, retrieved_at } = article.data;
const lastChecked = retrieved_at.toISOString().slice(0, 10);
const heading = kind === 'preamble' ? '前文' : `日本国憲法 第${article.data.number}条`;
const pageTitle = kind === 'preamble' ? '前文' : `第${article.data.number}条`;
const description = `${heading}の本文。${paragraphs[0]?.text.slice(0, 80) ?? ''}…`;

// verified: false のコメントは公開しない (docs/design.md 10)
const comments = (await getCollection('comments')).filter(
  (comment) => comment.data.verified && comment.data.article_ids.includes(article.id),
);

const base = import.meta.env.BASE_URL;

// この条文を変更・削除している改憲案への逆リンク (条文ページ→改憲案)。
// is_new の草案条文は、番号が偶然衝突していても比較対象ではないため対象外にする
// (docs/design.md 5.2)。改番されている場合は renamed_from を実際の対象として扱う。
interface AffectingDraft {
  draftName: string;
  title: string;
  href: string;
  isDeleted: boolean;
}

const drafts = await getCollection('drafts');
const draftById = new Map(drafts.map((draft) => [draft.id, draft]));

const affectingDrafts: AffectingDraft[] = [];

for (const entry of await getCollection('draftArticles')) {
  if (entry.data.is_new) continue;
  const affectedId = entry.data.renamed_from ?? entry.data.id;
  if (affectedId !== article.id) continue;
  const draftId = entry.id.split('/')[0];
  const draft = draftById.get(draftId);
  if (!draft) continue;
  affectingDrafts.push({
    draftName: draft.data.name,
    title: entry.data.title,
    href: `${base}drafts/${draftId}/${entry.data.id}`,
    isDeleted: false,
  });
}

for (const entry of await getCollection('draftDeletions')) {
  if (entry.data.id !== article.id) continue;
  const draftId = entry.id.split('/')[0];
  const draft = draftById.get(draftId);
  if (!draft) continue;
  affectingDrafts.push({
    draftName: draft.data.name,
    title: entry.data.title,
    href: `${base}drafts/${draftId}/deleted/${entry.data.id}`,
    isDeleted: true,
  });
}
---

<BaseLayout title={`${pageTitle} | 日本国憲法レビュー`} description={description}>
	<p class="font-mono mb-4 text-sm">
		<a href={base}>&larr; 条文一覧</a>
	</p>

	<div class="overflow-hidden rounded-md border" style="border-color: var(--line);">
		<div class="font-mono flex items-center gap-2 border-b px-3 py-2 text-xs" style="border-color: var(--line); background: var(--paper-raised); color: var(--ink-muted);">
			<span>data/articles/{article.id}.yaml</span>
		</div>
		<div class="px-4 py-5">
			{kind === 'article' && (
				<p class="font-mono mb-1 text-xs" style="color: var(--ink-muted);">{article.data.chapter}</p>
			)}
			<h1 class="font-mincho mb-4 text-2xl" style="color: var(--ink);">{heading}</h1>

			{kind === 'preamble' && (
				<p class="mb-3 text-sm" style="color: var(--ink-muted);">
					※ 段落分けは表示の都合上付与したものであり、原文(官報)に段落番号はありません。
				</p>
			)}

			<div class="font-mincho divide-y" style="border-color: var(--line);">
				{paragraphs.map((paragraph) => (
					<div class="flex gap-4 py-2 leading-relaxed">
						{kind === 'article' && (
							<span class="font-mono shrink-0 pt-0.5 text-right text-xs" style="width: 1.5rem; color: var(--ink-muted);">
								{paragraph.no}
							</span>
						)}
						<p style="color: var(--ink);">{paragraph.text}</p>
					</div>
				))}
			</div>
		</div>
	</div>

	{affectingDrafts.length > 0 && (
		<section class="mt-6">
			<h2 class="font-mono mb-3 text-sm" style="color: var(--ink-muted);">この条文を変更・削除している改憲案({affectingDrafts.length})</h2>
			<ul class="divide-y border-t border-b" style="border-color: var(--line);">
				{affectingDrafts.map((d) => (
					<li class="flex items-start gap-3 py-2">
						<span
							class="mt-1.5 inline-block h-3 w-3 shrink-0 rounded-full"
							style={`background: var(${d.isDeleted ? '--ink-muted' : '--danger'});`}
							aria-hidden="true"
						/>
						<div>
							<a href={d.href} class="no-underline hover:underline">
								<span class="font-mincho" style="color: var(--ink);">{d.title}</span>
							</a>
							<p class="font-mono mt-0.5 text-xs" style="color: var(--ink-muted);">
								{d.draftName}
								{d.isDeleted && <span class="tag">削除</span>}
							</p>
						</div>
					</li>
				))}
			</ul>
		</section>
	)}

	<CommentList comments={comments} heading="この条文についてのコメント" />

	<footer class="font-mono mt-8 text-xs" style="color: var(--ink-muted);">
		<p>出典: <a href={source_url}>{source_url}</a></p>
		<p>最終確認日: {lastChecked}</p>
	</footer>
</BaseLayout>
