---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { kind, paragraphs, source_url, retrieved_at } = article.data;
const lastChecked = retrieved_at.toISOString().slice(0, 10);
const heading = kind === 'preamble' ? '前文' : `日本国憲法 第${article.data.number}条`;
const pageTitle = kind === 'preamble' ? '前文' : `第${article.data.number}条`;

// verified: false のコメントは公開しない (docs/design.md 10)
const comments = (await getCollection('comments')).filter(
  (comment) => comment.data.verified && comment.data.article_ids.includes(article.id),
);

const stanceLabel = { support: '賛成', oppose: '反対', neutral: '中立' } as const;
const claimTypeLabel = { fact: '事実', interpretation: '解釈', concern: '懸念・予測', quote: '引用' } as const;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} | 日本国憲法レビュー</title>
	</head>
	<body>
		<p><a href={import.meta.env.BASE_URL}>&larr; トップへ戻る</a></p>
		{kind === 'article' && <p>{article.data.chapter}</p>}
		<h1>{heading}</h1>
		{kind === 'preamble' ? (
			<>
				<p>※ 段落分けは表示の都合上付与したものであり、原文(官報)に段落番号はありません。</p>
				{paragraphs.map((paragraph) => <p>{paragraph.text}</p>)}
			</>
		) : (
			<ol>
				{paragraphs.map((paragraph) => (
					<li value={paragraph.no}>{paragraph.text}</li>
				))}
			</ol>
		)}
		{comments.length > 0 && (
			<section>
				<h2>この条文についてのコメント</h2>
				<ul>
					{comments.map((comment) => (
						<li>
							<p>
								<strong>{comment.data.speaker.name}</strong>
								({comment.data.speaker.role}・{comment.data.speaker.party}) —
								{stanceLabel[comment.data.stance]} / {claimTypeLabel[comment.data.claim_type]}
							</p>
							<blockquote>{comment.data.excerpt}</blockquote>
							<p>{comment.data.summary}</p>
							<p>
								{comment.data.venue}({comment.data.date.toISOString().slice(0, 10)})
								{comment.data.source_url && (
									<>
										{' '}/ 出典: <a href={comment.data.source_url}>{comment.data.source_url}</a>
									</>
								)}
							</p>
						</li>
					))}
				</ul>
			</section>
		)}
		<footer>
			<p>出典: <a href={source_url}>{source_url}</a></p>
			<p>最終確認日: {lastChecked}</p>
		</footer>
	</body>
</html>
