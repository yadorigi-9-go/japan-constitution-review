---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { kind, paragraphs, source_url, retrieved_at } = article.data;
const lastChecked = retrieved_at.toISOString().slice(0, 10);
const heading = kind === 'preamble' ? '前文' : `日本国憲法 第${article.data.number}条`;
const pageTitle = kind === 'preamble' ? '前文' : `第${article.data.number}条`;

// verified: false のコメントは公開しない (docs/design.md 10)
const comments = (await getCollection('comments')).filter(
  (comment) => comment.data.verified && comment.data.article_ids.includes(article.id),
);

const stanceLabel = { support: '賛成', oppose: '反対', neutral: '中立' } as const;
const claimTypeLabel = { fact: '事実', interpretation: '解釈', concern: '懸念・予測', quote: '引用' } as const;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${pageTitle} | 日本国憲法レビュー`}>
	<p class="font-mono mb-4 text-sm">
		<a href={base}>&larr; 条文一覧</a>
	</p>

	<div class="overflow-hidden rounded-md border" style="border-color: var(--line);">
		<div class="font-mono flex items-center gap-2 border-b px-3 py-2 text-xs" style="border-color: var(--line); background: var(--paper-raised); color: var(--ink-muted);">
			<span>data/articles/{article.id}.yaml</span>
		</div>
		<div class="px-4 py-5">
			{kind === 'article' && (
				<p class="font-mono mb-1 text-xs" style="color: var(--ink-muted);">{article.data.chapter}</p>
			)}
			<h1 class="font-mincho mb-4 text-2xl" style="color: var(--ink);">{heading}</h1>

			{kind === 'preamble' && (
				<p class="mb-3 text-sm" style="color: var(--ink-muted);">
					※ 段落分けは表示の都合上付与したものであり、原文(官報)に段落番号はありません。
				</p>
			)}

			<div class="font-mincho divide-y" style="border-color: var(--line);">
				{paragraphs.map((paragraph) => (
					<div class="flex gap-4 py-2 leading-relaxed">
						{kind === 'article' && (
							<span class="font-mono shrink-0 pt-0.5 text-right text-xs" style="width: 1.5rem; color: var(--ink-muted);">
								{paragraph.no}
							</span>
						)}
						<p style="color: var(--ink);">{paragraph.text}</p>
					</div>
				))}
			</div>
		</div>
	</div>

	{comments.length > 0 && (
		<section class="mt-8">
			<h2 class="font-mono mb-3 text-sm" style="color: var(--ink-muted);">この条文についてのコメント({comments.length})</h2>
			<ul class="space-y-4">
				{comments.map((comment) => (
					<li class="overflow-hidden rounded-md border" style="border-color: var(--line);">
						<div class="flex items-center gap-2 border-b px-3 py-2 text-sm" style="border-color: var(--line); background: var(--paper-raised);">
							<span class="avatar" aria-hidden="true">{comment.data.speaker.name.slice(0, 1)}</span>
							<strong style="color: var(--ink);">{comment.data.speaker.name}</strong>
							<span class="tag">{comment.data.speaker.party}</span>
							<span class="font-mono ml-auto text-xs" style="color: var(--ink-muted);">
								{comment.data.date.toISOString().slice(0, 10)}
							</span>
						</div>
						<div class="comment-card m-3" data-stance={comment.data.stance}>
							<p class="mb-2 text-xs" style="color: var(--ink-muted);">
								{comment.data.speaker.role} ・ {stanceLabel[comment.data.stance]} ・ {claimTypeLabel[comment.data.claim_type]}
							</p>
							<blockquote class="font-mincho mb-2 border-l-2 pl-3" style="border-color: var(--line); color: var(--ink);">
								{comment.data.excerpt}
							</blockquote>
							<p class="mb-1 text-sm" style="color: var(--ink);">{comment.data.summary}</p>
							<p class="font-mono text-xs" style="color: var(--ink-muted);">
								{comment.data.venue}
								{comment.data.source_url && (
									<>
										{' '}/ <a href={comment.data.source_url}>出典</a>
									</>
								)}
							</p>
						</div>
					</li>
				))}
			</ul>
		</section>
	)}

	<footer class="font-mono mt-8 text-xs" style="color: var(--ink-muted);">
		<p>出典: <a href={source_url}>{source_url}</a></p>
		<p>最終確認日: {lastChecked}</p>
	</footer>
</BaseLayout>
