---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	// base からの相対パス(例: "og/articles/art-009.png")。省略時はサイト共通画像を使う
	// (docs/design.md 9節、条文・改憲案ごとのOGP画像自動生成)。
	ogImage?: string;
}

const defaultDescription =
	'日本国憲法と改憲案の論点・リスクを、コードレビュー形式で検証する非公式サイト。';
const { title, description = defaultDescription, ogImage } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage ?? `${base}og/default.png`, Astro.site);
const isActive = (segment: string) => path === `${base}${segment}` || path.startsWith(`${base}${segment}/`);
const tabs = [
	{ href: base, label: '条文', icon: '📄', active: path === base || path.startsWith(`${base}articles/`) },
	{ href: `${base}drafts`, label: '改憲案', icon: '🔀', active: isActive('drafts') },
	{ href: `${base}search`, label: '検索', icon: '🔎', active: isActive('search') },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title="日本国憲法レビュー 更新履歴" href={`${base}rss.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="日本国憲法レビュー" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<slot name="head" />
		<script is:inline>
			// ちらつき防止のため、スタイル適用前に同期的にテーマを決定する。
			(() => {
				const stored = localStorage.getItem('theme');
				const theme = stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="min-h-screen">
		<header style={`background: var(--paper-raised); border-bottom: 1px solid var(--line);`}>
			<div class="mx-auto flex max-w-4xl items-center gap-4 px-4 py-3">
				<a href={base} class="font-mincho text-lg no-underline" style={`color: var(--ink);`}>
					日本国憲法レビュー
				</a>
				<a
					href="https://github.com/yadorigi-9-go/japan-constitution-review"
					class="theme-toggle ml-auto"
					style="display: inline-flex;"
					aria-label="GitHubでソースコードを見る"
					target="_blank"
					rel="noopener"
				>
					<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
				<button id="theme-toggle" type="button" class="theme-toggle" aria-label="配色を切り替え">
					<span id="theme-toggle-icon">🌙</span>
				</button>
			</div>
		</header>
		<div style={`background: var(--paper); border-bottom: 1px solid var(--line);`}>
			<nav class="font-mono mx-auto flex max-w-4xl gap-1 px-2 text-sm">
				{tabs.map((tab) => (
					<a
						href={tab.href}
						class="flex items-center gap-1.5 border-b-2 px-3 py-2.5 no-underline"
						style={tab.active
							? `border-color: var(--danger); color: var(--ink); font-weight: 600;`
							: `border-color: transparent; color: var(--ink-muted);`}
					>
						<span aria-hidden="true">{tab.icon}</span>
						{tab.label}
					</a>
				))}
			</nav>
		</div>
		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				const button = document.getElementById('theme-toggle');
				const icon = document.getElementById('theme-toggle-icon');
				const updateIcon = () => {
					icon.textContent = document.documentElement.dataset.theme === 'dark' ? '☀️' : '🌙';
				};
				updateIcon();
				button.addEventListener('click', () => {
					const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = next;
					localStorage.setItem('theme', next);
					updateIcon();
				});
			});
		</script>
		<main class="mx-auto max-w-4xl px-4 py-6">
			<slot />
		</main>
	</body>
</html>
